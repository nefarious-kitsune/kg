{
    "files.eol": "\n",
    "editor.tabSize": 2,
    "files.associations": {
      "*.gs": "javascript",
    },
    "cSpell.words": [
      "Kitsune"
    ],
    "cSpell.customDictionaries": {
      "kg": {
        "name": "kg",
        "path": "${workspaceRoot}/.vscode/kg.txt",
        "scope": "user",
        "addWords": true
      },
      "markdown": {
        "name": "markdown",
        "path": "${workspaceRoot}/.vscode/markdown.txt",
        "scope": "user",
        "addWords": true
      }
    },
    "files.exclude": {
      "**/node_modules/": true
    }
}